# Ubudu RTLS SDK: variables of the live tests and the examples. Copy to .env and fill in the
# first two. The harness and examples/shared/config read .env; nothing prints its values.

# API key of the test namespace (sent as X-API-Key)
RTLS_API_KEY=
# Application namespace the live tests and examples run against
APP_NAMESPACE=
# Base URL of the API (empty = default https://rtls.ubudu.com/api)
RTLS_BASE_URL=
# Optional run id override: 8 lowercase hex characters (empty = a random id per run)
RTLS_IT_RUN_ID=

# Tier flags: set to 1 on the command line only, never here (a tier key in .env stops a run with exit 2).
# RTLS_IT_WRITES
#   tier W: set to 1 on the command line only, never here
# RTLS_IT_CONFIG
#   tier C: set to 1 on the command line only, never here
# RTLS_IT_SIDE_EFFECTS
#   tier S: set to 1 on the command line only, never here
