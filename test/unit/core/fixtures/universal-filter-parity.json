        {
          "w": 2
        }
      ]
    },
    {
      "name": "falsy primitive items have no fields",
      "items": ["", "ab", 0, 5],
      "query": {
        "length:eq": "0"
      },
      "expected": []
    },
    {
      "name": "sort: an empty field is ignored",
      "items": [
        {
          "n": 2
        },
        {
          "n": 1
        }
      ],
      "query": {
        "sort": ":desc"
      },
      "expected": [
        {
          "n": 2
        },
        {
          "n": 1
        }
      ]
    },
    {
      "name": "sort: index syntax on an array field",
      "items": [
        {
          "id": 1,
          "t": ["b"]
        },
        {
          "id": 2,
          "t": ["a"]
        },
        {
          "id": 3,
          "t": "c"
        }
      ],
      "query": {
        "sort": "t[0]:asc"
      },
      "expected": [
        {
          "id": 2,
          "t": ["a"]
        },
        {
          "id": 1,
          "t": ["b"]
        },
        {
          "id": 3,
          "t": "c"
        }
      ]
    },
    {
      "name": "fields: index syntax keeps the literal key",
      "items": [
        {
          "id": 1,
          "t": ["a", "b"]
        }
      ],
      "query": {
        "fields": "id,t[1]"
      },
      "expected": [
        {
          "id": 1,
          "t[1]": "b"
        }
      ]
    },
    {
      "name": "fields: an empty name selects nothing",
      "items": [
        {
          "id": 1,
          "name": "a"
        }
      ],
      "query": {
        "fields": "id,,"
      },
      "expected": [
        {
          "id": 1
        }
      ]
    },
    {
      "name": "fields: a parent then its child",
      "items": [
        {
          "data": {
            "x": 1,
            "y": 2
          }
        }
      ],
      "query": {
        "fields": "data,data.x"
      },
      "expected": [
        {
          "data": {
            "x": 1,
            "y": 2
          }
        }
      ]
    },
    {
      "name": "fields: a child then its parent",
      "items": [
        {
          "data": {
            "x": 1,
            "y": 2
          }
        }
      ],
      "query": {
        "fields": "data.x,data"
      },
      "expected": [
        {
          "data": {
            "x": 1,
            "y": 2
          }
        }
      ]
    },
    {
      "name": "fields: two children share their parent",
      "items": [
        {
          "data": {
            "x": 1,
            "y": 2,
            "z": 3
          }
        }
      ],
      "query": {
        "fields": "data.x,data.y"
      },
      "expected": [
        {
          "data": {
            "x": 1,
            "y": 2
          }
        }
      ]
    },
    {
      "name": "fields: a deep child under a projected parent",
      "items": [
        {
          "a": {
            "b": {
              "c": 1,
              "d": 2
            }
          }
        }
      ],
      "query": {
        "fields": "a.b,a.b.c"
      },
      "expected": [
        {
          "a": {
            "b": {
              "c": 1,
              "d": 2
            }
          }
        }
      ]
    }
  ]
}
