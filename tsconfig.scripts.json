{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "scripts/**/*.js",
    "scripts/**/*.mjs",
    "scripts/**/*.cjs",
    "scripts/**/*.d.ts",
    "test/integration/harness/*.mjs",
    "docs/api/tools/**/*.mjs",
    "docs/api/tools/**/*.d.mts",
    "examples/run-all.mjs",
    "examples/run-all.d.mts"
  ],
  "exclude": ["node_modules", "dist", "coverage", ".cache"]
}
